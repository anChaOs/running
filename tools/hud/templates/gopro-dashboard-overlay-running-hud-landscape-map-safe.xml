<layout>
    <!-- 暖墨沙面板。左列三块同宽，块内文字右对齐；地图未跑灰+三角朝向。 -->
    <!-- 列规：x=40 · 宽 250 · 块间距 14 · 底边距 48 · 内边距 20 · 右缘内容 x=230 · 圆角 22。 -->

    <translate x="40" y="40">
        <component type="circuit-map" size="360" loc-size="14" fill="232,201,164,255" outline="42,26,16,200" fill_width="10" outline_width="4"/>
    </translate>

    <frame x="444" y="40" width="1032" height="77" bg="77,49,30,255" cr="38" opacity="0.87" name="context_top_rail">
        <translate x="26" y="22">
            <component type="metric" x="86" y="0" metric="odo" units="km" dp="2" size="26" align="right" rgb="255,255,255" outline_width="0"/>
            <component type="text" x="94" y="6" size="16" rgb="255,255,255" outline_width="0">km</component>
        </translate>
        <translate x="173" y="34">
            <component type="bar" name="distance_progress_bar" width="686" height="10" metric="odo" units="m" min="0" max="10000" knob="circle" knob-size="26" fill="28,16,10,170" outline="255,255,255,0" outline-width="0" bar="246,239,228,255" h-neg="246,239,228,255" h-pos="246,239,228,255" zero="255,255,255,0" cr="5"/>
        </translate>
        <translate x="876" y="22">
            <component type="text" name="distance_total_text" x="0" y="0" size="26" rgb="255,255,255" outline_width="0">10.00</component>
            <component type="text" name="distance_total_unit" x="77" y="6" size="16" rgb="255,255,255" outline_width="0">km</component>
        </translate>
    </frame>

    <!-- P0 配速：列宽 250，右边距 20（锚点 x=230） -->
    <frame x="40" y="588" width="250" height="158" bg="77,49,30,255" cr="22" opacity="0.87" name="performance_primary_panel">
        <component type="metric" x="230" y="18" metric="speed" units="pace_km" format="pace_quote" size="52" align="right" rgb="255,255,255" outline_width="0"/>
        <component type="metric" x="187" y="84" metric="hr" dp="0" size="26" align="right" rgb="255,255,255" outline_width="0"/>
        <component type="text" x="193" y="90" size="16" rgb="255,255,255" outline_width="0">bpm</component>
        <component type="metric" x="187" y="118" metric="cadence" units="spm" dp="0" size="26" align="right" rgb="255,255,255" outline_width="0"/>
        <component type="text" x="193" y="124" size="16" rgb="255,255,255" outline_width="0">spm</component>
    </frame>

    <!-- P1 时长+天气 -->
    <frame x="40" y="760" width="250" height="202" bg="77,49,30,255" cr="22" opacity="0.87" name="context_secondary_panel">
        <component type="metric" x="230" y="16" metric="elapsed" format="hms" size="44" align="right" rgb="255,255,255" outline_width="0"/>
        <component type="datetime" x="230" y="70" format="%Y/%m/%d · %H:%M:%S" size="15" align="right" rgb="255,255,255,170" outline_width="0"/>
        <translate name="weather_group" x="0" y="0">
            <frame x="90" y="104" width="140" height="32" bg="112,78,52,255" cr="16" opacity="1" name="wx_env_pill">
                <component type="text" x="12" y="5" size="14" rgb="255,255,255" outline_width="0">AIR</component>
                <component type="text" name="wx_env_values" x="128" y="5" size="14" align="right" rgb="255,255,255" outline_width="0">88% · 23°</component>
            </frame>
            <frame x="90" y="148" width="140" height="32" bg="112,78,52,255" cr="16" opacity="1" name="wx_body_pill">
                <component type="text" x="12" y="5" size="14" rgb="255,255,255" outline_width="0">FEEL</component>
                <component type="text" name="wx_body_values" x="128" y="5" size="14" align="right" rgb="255,255,255" outline_width="0">27°</component>
            </frame>
        </translate>
    </frame>

    <!-- P2 鞋 -->
    <frame x="40" y="976" width="250" height="56" bg="77,49,30,255" cr="22" opacity="0.82" name="shoe_chip_panel">
        <translate name="shoe_mileage_group" x="0" y="0">
            <component type="text" name="shoe_name_text" x="98" y="16" size="15" align="right" rgb="255,255,255,200" outline_width="0">shoe name</component>
            <component type="metric" x="111" y="10" name="shoe_mileage_metric" metric="shoe_odo" units="km" dp="2" size="22" align="left" rgb="255,255,255,220" outline_width="0"/>
            <component type="text" x="207" y="16" size="14" rgb="255,255,255,180" outline_width="0">km</component>
        </translate>
    </frame>
</layout>
